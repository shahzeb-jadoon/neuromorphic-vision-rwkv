# Machine-specific settings. Copy to .env (git-ignored) and fill in:
#   cp .env.example .env
# Values set in the environment take precedence over this file.

# Directory holding the collected episode_*.h5 files.
DATA_DIR=/path/to/carla_data

# CARLA server address for scripts that connect directly.
CARLA_HOST=localhost
CARLA_PORT=2000
