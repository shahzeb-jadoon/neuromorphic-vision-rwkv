# =============================================================================
# Neuromorphic Vision-RWKV — Environment Configuration
# =============================================================================
# Copy this file to .env and adjust for your machine:
#   cp .env.example .env
#
# Values below are defaults for a laptop/WSL2 development setup.
# =============================================================================

# --- Machine Role ---
# Identifies this machine for configuration branching.
# Options: "laptop" | "workstation-a" | "workstation-b" | "jetson"
MACHINE_ROLE=laptop

# --- CARLA Simulator ---
# "auto" detects Windows host IP from WSL2 gateway (recommended for WSL2).
# Use "localhost" for native Linux or Docker setups.
CARLA_HOST=auto
CARLA_PORT=2000

# --- Data Paths ---
# Where collected episodes and checkpoints are stored.
# For machines with a network home directory, point to local SSD for I/O performance:
#   DATA_DIR=/local/datasets/neuromorphic-vision-rwkv
DATA_DIR=./data/collected
CHECKPOINT_DIR=./checkpoints

# --- Training / Logging ---
WANDB_PROJECT=neuromorphic-vision-rwkv
WANDB_ENTITY=your-wandb-username
# Comma-separated GPU indices. Use "0" for single GPU.
CUDA_VISIBLE_DEVICES=0

# --- Workstation Overrides (uncomment as needed) ---
# NFS-backed home for persistent storage across machines:
# NFS_DATA_DIR=$HOME/datasets/neuromorphic-vision-rwkv
# Local SSD cache for fast training I/O:
# LOCAL_CACHE_DIR=/tmp/rwkv-cache
